# ─── Supabase (accounts + friends) ───────────────────────────────────────────
# Supabase → Project Settings → API. Paste the PROJECT URL and the ANON /
# PUBLISHABLE key (never the service_role / secret key).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# These aliases are also accepted, in case your dashboard/integration used them:
#   URL: NEXT_PUBLIC_SUPABASE_URL, VITE_SUPABASE_URL, PUBLIC_SUPABASE_URL,
#        NUXT_PUBLIC_SUPABASE_URL, SUPABASE_PROJECT_URL
#   KEY: NEXT_PUBLIC_SUPABASE_ANON_KEY, VITE_SUPABASE_ANON_KEY,
#        PUBLIC_SUPABASE_ANON_KEY, SUPABASE_PUBLISHABLE_KEY, SUPABASE_PUBLIC_KEY,
#        SUPABASE_KEY (legacy)

# ─── Owner console ───────────────────────────────────────────────────────────
# The admin panel belongs to the account named ghanimz. Uncomment to add extra
# owners (comma separated); the default owner is always enabled.
# ADMIN_USERNAME=ghanimz

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
