{
  "name": "100-days-outrun",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "100 Days Outrun — a 3D multiplayer post-apocalyptic highway survival run with Supabase accounts, friends, phone controls and an Express + Socket.IO realtime server that keeps itself awake on Render.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "relay": "node server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node tests/run-all.mjs",
    "test:build": "node tests/build.mjs",
    "games": "node scripts/scan-games.mjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "game",
    "threejs",
    "multiplayer",
    "socket.io",
    "survival",
    "3d",
    "vercel"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
